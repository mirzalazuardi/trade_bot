<% content_for :title, "ML Performance" %>

<div class="sm:flex sm:items-center">
  <div class="sm:flex-auto">
    <h1 class="text-xl font-semibold text-gray-900">ML Performance</h1>
    <p class="mt-2 text-sm text-gray-700">Track AI signal filtering effectiveness and trade outcomes.</p>
  </div>
</div>

<div class="mt-6 bg-white shadow sm:rounded-lg">
  <div class="p-6">
    <%= form_with url: ml_performance_index_path, method: :get, class: "flex gap-4 flex-wrap" do |f| %>
      <div>
        <%= f.label :ml_model_id, "Model", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :ml_model_id, options_for_select(@ml_models.map { |m| [m.name, m.id] }), include_blank: "All Models", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :bot_id, "Bot", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :bot_id, options_for_select(@bots.map { |b| ["#{b.exchange_name} - #{b.pair}", b.id] }), include_blank: "All Bots", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :from, "From Date", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :from, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :to, "To Date", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :to, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div class="self-end">
        <%= f.submit "Filter", class: "inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
      </div>
    <% end %>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
  <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
    <dt class="truncate text-sm font-medium text-gray-500">Total Predictions</dt>
    <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @performance.total_predictions %></dd>
  </div>
  <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
    <dt class="truncate text-sm font-medium text-gray-500">Executed Signals</dt>
    <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @performance.executed_signals %></dd>
  </div>
  <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
    <dt class="truncate text-sm font-medium text-gray-500">Filtered Signals</dt>
    <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @performance.filtered_signals %> <span class="text-sm font-normal text-gray-500">(<%= (@performance.filter_rate * 100).round(1) %>)</span></dd>
  </div>
  <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
    <dt class="truncate text-sm font-medium text-gray-500">Accuracy Rate</dt>
    <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= (@performance.accuracy * 100).round(1) %>%</dd>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
  <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
    <h3 class="text-lg font-medium leading-6 text-gray-900">Confidence Distribution</h3>
    <div class="mt-4">
      <div class="relative pt-1">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-600">Low (0-30%)</span>
          <span class="text-sm font-medium text-gray-900"><%= @performance.low %></span>
        </div>
        <div class="mb-6 h-2 w-full overflow-hidden rounded bg-gray-200">
          <div class="h-2 bg-red-500 transition-all duration-300" style="width: <%= @performance.total_predictions > 0 ? (@performance.low.to_f / @performance.total_predictions * 100) : 0 %>%"></div>
        </div>
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-600">Moderate (30-70%)</span>
          <span class="text-sm font-medium text-gray-900"><%= @performance.moderate %></span>
        </div>
        <div class="mb-6 h-2 w-full overflow-hidden rounded bg-gray-200">
          <div class="h-2 bg-yellow-500 transition-all duration-300" style="width: <%= @performance.total_predictions > 0 ? (@performance.moderate.to_f / @performance.total_predictions * 100) : 0 %>%"></div>
        </div>
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-600">High (70-100%)</span>
          <span class="text-sm font-medium text-gray-900"><%= @performance.high %></span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded bg-gray-200">
          <div class="h-2 bg-green-500 transition-all duration-300" style="width: <%= @performance.total_predictions > 0 ? (@performance.high.to_f / @performance.total_predictions * 100) : 0 %>%"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
    <h3 class="text-lg font-medium leading-6 text-gray-900">Trade Outcomes</h3>
    <div class="mt-4">
      <div class="flex items-center justify-between border-b pb-2">
        <span class="text-sm text-gray-500">Profitable Trades</span>
        <span class="text-sm font-medium text-green-600"><%= @performance.profitable_trades %></span>
      </div>
      <div class="flex items-center justify-between pt-2">
        <span class="text-sm text-gray-500">Losing Trades</span>
        <span class="text-sm font-medium text-red-600"><%= @performance.losing_trades %></span>
      </div>
    </div>
  </div>
</div>

<% if @performance.total_predictions.zero? %>
  <div class="mt-6 rounded-lg bg-gray-50 p-8 text-center">
    <p class="text-gray-500">No ML predictions recorded yet. Enable AI on your bots to start tracking.</p>
    <%= link_to "Go to Bots", bots_path, class: "mt-4 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>
<% end %>