{
  "name": "RSI Reversal",
  "version": "1.0",
  "description": "Buy when RSI oversold, sell when overbought",
  "indicators": {
    "rsi": { "period": 14 }
  },
  "entry": {
    "buy": {
      "condition": "rsi < {{oversold}}",
      "confidence": "map(rsi, 0, {{oversold}}, 0.95, 0.5)"
    },
    "sell": {
      "condition": "rsi > {{overbought}}",
      "confidence": "map(rsi, {{overbought}}, 100, 0.5, 0.95)"
    }
  },
  "exit": {
    "buy": "rsi > 50",
    "sell": "rsi < 50"
  },
  "parameters": {
    "rsi_period": 14,
    "oversold": 30,
    "overbought": 70
  }
}
