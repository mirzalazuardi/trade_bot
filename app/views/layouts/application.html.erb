<!DOCTYPE html>
<html class="h-full bg-gray-50">
  <head>
    <title><%= content_for(:title) || "TradeBot" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <% if defined?(authenticated?) && authenticated? %>
      <nav class="bg-gray-900">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-14 items-center justify-between">
            <div class="flex items-center gap-6">
              <%= link_to "TradeBot", root_path, class: "text-white font-bold text-lg" %>
              <div class="hidden sm:flex gap-4">
                <%= link_to "Dashboard", root_path, class: "text-gray-300 hover:text-white text-sm" %>
                <%= link_to "Credentials", exchange_credentials_path, class: "text-gray-300 hover:text-white text-sm" %>
                <%= link_to "Bots", "#", class: "text-gray-300 hover:text-white text-sm" %>
                <%= link_to "Trades", "#", class: "text-gray-300 hover:text-white text-sm" %>
                <%= link_to "Portfolio", "#", class: "text-gray-300 hover:text-white text-sm" %>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-gray-400 text-sm hidden sm:inline"><%= Current.user&.email_address %></span>
              <%= button_to "Logout", session_path, method: :delete, class: "text-gray-300 hover:text-white text-sm" %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice.present? %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
        <div class="rounded-md bg-green-50 p-4">
          <p class="text-sm text-green-700"><%= notice %></p>
        </div>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
        <div class="rounded-md bg-red-50 p-4">
          <p class="text-sm text-red-700"><%= alert %></p>
        </div>
      </div>
    <% end %>

    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>
  </body>
</html>
