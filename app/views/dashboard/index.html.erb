<div class="space-y-6">
  <h1 class="text-2xl font-bold">Dashboard</h1>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Today PnL</div>
      <div class="text-2xl font-bold <%= @today_pnl >= 0 ? 'text-green-600' : 'text-red-600' %>">
        <%= number_to_currency(@today_pnl) %>
      </div>
      <div class="text-sm text-gray-500"><%= @today_trades %> trades</div>
    </div>

    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Total PnL</div>
      <div class="text-2xl font-bold <%= @total_pnl >= 0 ? 'text-green-600' : 'text-red-600' %>">
        <%= number_to_currency(@total_pnl) %>
      </div>
      <div class="text-sm text-gray-500">All time</div>
    </div>

    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Total Fees</div>
      <div class="text-2xl font-bold text-gray-800">
        <%= number_to_currency(@total_fees) %>
      </div>
    </div>

    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Active Bots</div>
      <div class="text-2xl font-bold text-blue-600">
        <%= @active_bots %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="bg-white p-4 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-3">Crypto</h2>
      <div class="space-y-2">
        <% @market_prices[:crypto].each do |price| %>
          <div class="flex justify-between items-center border-b pb-1">
            <span class="font-medium"><%= price[:pair] %></span>
            <div class="text-right">
              <div class="font-semibold"><%= price[:price] ? number_to_currency(price[:price], precision: 2) : "—" %></div>
              <div class="text-xs <%= price[:change].to_f >= 0 ? 'text-green-600' : 'text-red-600' %>">
                <%= price[:change] ? "#{price[:change] >= 0 ? '+' : ''}#{price[:change]}%" : "—" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white p-4 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-3">Forex</h2>
      <div class="space-y-2">
        <% @market_prices[:forex].each do |price| %>
          <div class="flex justify-between items-center border-b pb-1">
            <span class="font-medium"><%= price[:pair] %></span>
            <div class="text-right">
              <div class="font-semibold"><%= price[:price] ? number_to_currency(price[:price], precision: 5) : "—" %></div>
              <div class="text-xs <%= price[:change].to_f >= 0 ? 'text-green-600' : 'text-red-600' %>">
                <%= price[:change] ? "#{price[:change] >= 0 ? '+' : ''}#{price[:change]}%" : "—" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white p-4 rounded-lg shadow">
      <h2 class="text-lg font-semibold mb-3">Commodities</h2>
      <div class="space-y-2">
        <% @market_prices[:commodities].each do |price| %>
          <div class="flex justify-between items-center border-b pb-1">
            <span class="font-medium"><%= price[:pair] %></span>
            <div class="text-right">
              <div class="font-semibold"><%= price[:price] ? number_to_currency(price[:price], precision: 2) : "—" %></div>
              <div class="text-xs <%= price[:change].to_f >= 0 ? 'text-green-600' : 'text-red-600' %>">
                <%= price[:change] ? "#{price[:change] >= 0 ? '+' : ''}#{price[:change]}%" : "—" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% risk_color = { high: "bg-red-100 text-red-800", medium: "bg-yellow-100 text-yellow-800", low: "bg-green-100 text-green-800" } %>
  <% regime_color = { risk_off: "text-red-600", mixed: "text-yellow-600", risk_on: "text-green-600" } %>
  <% bias_color = { bearish: "text-red-600", neutral: "text-gray-600", bullish: "text-green-600" } %>

  <div class="rounded-lg shadow overflow-hidden">
    <div class="<%= @market_context[:calendar_risk] == :high ? 'bg-red-600' : @market_context[:calendar_risk] == :medium ? 'bg-yellow-500' : 'bg-gray-900' %> text-white p-4">
      <div class="flex justify-between items-center">
        <h2 class="text-lg font-semibold">Market Intelligence</h2>
        <div class="flex gap-3 text-sm">
          <span>Regime: <strong class="<%= regime_color[@market_context[:risk_regime]] || 'text-gray-300' %>"><%= @market_context[:risk_regime] %></strong></span>
          <span>Bias: <strong class="<%= bias_color[@market_context[:bias]] || 'text-gray-300' %>"><%= @market_context[:bias] %></strong></span>
          <span>Size: <strong><%= (@market_context[:size_modifier] * 100).round %>%</strong></span>
        </div>
      </div>
      <% if @market_context[:summary].present? %>
        <p class="text-sm mt-2 opacity-90"><%= @market_context[:summary] %></p>
      <% end %>
    </div>

    <div class="bg-white p-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <h3 class="font-semibold text-sm text-gray-500 mb-2">Upcoming Events</h3>
          <% if @market_context[:upcoming_events].any? %>
            <div class="space-y-1">
              <% @market_context[:upcoming_events].first(5).each do |event| %>
                <div class="flex justify-between text-sm">
                  <span>
                    <span class="px-1.5 py-0.5 rounded text-xs <%= risk_color[event[:impact]] || 'bg-gray-100' %>"><%= event[:impact] %></span>
                    <%= event[:title] %> (<%= event[:country] %>)
                  </span>
                  <span class="text-gray-500"><%= event[:minutes_until] > 0 ? "in #{event[:minutes_until]}min" : "#{event[:minutes_until].abs}min ago" %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-400">No high-impact events upcoming</p>
          <% end %>

          <% if @market_context[:avoid_pairs].any? %>
            <div class="mt-2 text-sm">
              <span class="font-medium text-red-600">Avoid:</span>
              <span class="text-gray-600"><%= @market_context[:avoid_pairs].join(", ") %></span>
            </div>
          <% end %>
        </div>

        <div>
          <h3 class="font-semibold text-sm text-gray-500 mb-2">Polymarket Signals</h3>
          <% if @market_context[:polymarket_signals].any? %>
            <div class="space-y-1">
              <% @market_context[:polymarket_signals].first(5).each do |signal| %>
                <div class="text-sm">
                  <span class="px-1.5 py-0.5 rounded text-xs <%= risk_color[signal[:impact]] || 'bg-gray-100' %>"><%= signal[:type] %></span>
                  <span class="text-gray-700"><%= signal[:title].truncate(60) %></span>
                  <span class="font-medium"><%= (signal[:probability] * 100).round %>%</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-gray-400">No significant prediction market signals</p>
          <% end %>

          <% if @market_context[:polymarket_shifts].any? %>
            <div class="mt-2 space-y-1">
              <% @market_context[:polymarket_shifts].first(3).each do |shift| %>
                <div class="text-sm text-orange-600">
                  Shift: <%= shift[:question].truncate(50) %> → <strong><%= shift[:direction] %></strong> (<%= (shift[:probability] * 100).round %>%)
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white p-4 rounded-lg shadow">
    <h2 class="text-lg font-semibold mb-4">Balances</h2>
    <div class="space-y-2">
      <% @balances.each do |bal| %>
        <div class="flex justify-between border-b pb-2">
          <span class="font-medium"><%= bal[:exchange].titleize %></span>
          <span><%= number_to_currency(bal[:balance]) %> <%= bal[:currency] %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white p-4 rounded-lg shadow">
    <h2 class="text-lg font-semibold mb-4">Recent Trades</h2>
    <% if @recent_trades.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="text-left text-sm text-gray-500">
              <th class="pb-2">Pair</th>
              <th class="pb-2">Side</th>
              <th class="pb-2">Qty</th>
              <th class="pb-2">Entry</th>
              <th class="pb-2">Exit</th>
              <th class="pb-2">Net PnL</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_trades.each do |trade| %>
              <tr class="border-t">
                <td class="py-2"><%= trade.pair %></td>
                <td class="py-2"><span class="px-2 py-1 rounded text-sm <%= trade.side == 'buy' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>"><%= trade.side %></span></td>
                <td class="py-2"><%= trade.quantity %></td>
                <td class="py-2"><%= trade.entry_price %></td>
                <td class="py-2"><%= trade.exit_price %></td>
                <td class="py-2 font-medium <%= trade.net_pnl >= 0 ? 'text-green-600' : 'text-red-600' %>">
                  <%= number_to_currency(trade.net_pnl) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-500">No trades yet.</p>
    <% end %>
  </div>
</div>
