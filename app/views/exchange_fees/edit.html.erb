<div class="space-y-6">
  <h1 class="text-2xl font-bold">Edit Fee Schedule</h1>

  <%= form_with model: @exchange_fee, class: "bg-white p-6 rounded-lg shadow space-y-4" do |f| %>
    <div>
      <%= f.label :exchange_name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :exchange_name, disabled: true, class: "mt-1 block w-full rounded-md border-gray-300 bg-gray-100" %>
    </div>

    <div>
      <%= f.label :maker_rate, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :maker_rate, step: 0.0001, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div>
      <%= f.label :taker_rate, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :taker_rate, step: 0.0001, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>

    <div class="flex items-center">
      <%= f.check_box :spread_based, class: "rounded border-gray-300" %>
      <%= f.label :spread_based, class: "ml-2 text-sm text-gray-700" %>
    </div>

    <div>
      <%= f.submit "Update", class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700" %>
      <%= link_to "Cancel", exchange_fees_path, class: "ml-2 text-gray-600 hover:underline" %>
    </div>
  <% end %>
</div>
