<% content_for :title, "Edit ML Model" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-xl font-semibold text-gray-900 mb-6">Edit ML Model</h1>

  <%= form_with model: @ml_model, class: "space-y-6" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.text_field :name, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      <% if @ml_model.errors[:name].any? %>
        <p class="mt-2 text-sm text-red-600"><%= @ml_model.errors[:name].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :version, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.number_field :version, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      <% if @ml_model.errors[:version].any? %>
        <p class="mt-2 text-sm text-red-600"><%= @ml_model.errors[:version].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :model_type, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.select :model_type, options_for_select([["LightGBM", "lightgbm"], ["ONNX", "onnx"]], @ml_model.model_type), {}, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
      <% if @ml_model.errors[:model_type].any? %>
        <p class="mt-2 text-sm text-red-600"><%= @ml_model.errors[:model_type].join(", ") %></p>
      <% end %>
    </div>

    <div>
      <%= f.label :training_date, class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.date_field :training_date, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
    </div>

    <div>
      <%= f.label :file_path, "Model File Path", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.text_field :file_path, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
    </div>

    <div>
      <%= f.label :feature_list, "Feature List (JSON)", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.text_area :feature_list, rows: 3, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
    </div>

    <div>
      <%= f.label :performance_metrics, "Performance Metrics (JSON)", class: "block text-sm font-medium leading-6 text-gray-900" %>
      <%= f.text_area :performance_metrics, rows: 3, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
    </div>

    <div class="flex gap-4">
      <%= f.submit "Update Model", class: "flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
      <%= link_to "Cancel", ml_model_path(@ml_model), class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
