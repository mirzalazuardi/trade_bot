<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold"><%= @bot.exchange_name %> / <%= @bot.pair %></h1>
    <div class="space-x-2">
      <% if @bot.active? %>
        <%= button_to "Pause", pause_bot_path(@bot), method: :post, class: "bg-yellow-500 text-white px-3 py-1 rounded" %>
      <% elsif @bot.paused? %>
        <%= button_to "Resume", resume_bot_path(@bot), method: :post, class: "bg-green-500 text-white px-3 py-1 rounded" %>
      <% end %>
      <%= button_to "Stop", stop_bot_path(@bot), method: :post, class: "bg-red-500 text-white px-3 py-1 rounded" %>
      <%= button_to @bot.ai_enabled ? "Disable AI" : "Enable AI", toggle_ai_bot_path(@bot), method: :post, class: "bg-gray-500 text-white px-3 py-1 rounded" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Strategy</div>
      <div class="text-lg font-semibold"><%= @bot.strategy %></div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Mode</div>
      <div class="text-lg font-semibold"><%= @bot.mode %></div>
    </div>
    <div class="bg-white p-4 rounded-lg shadow">
      <div class="text-sm text-gray-500">Status</div>
      <div class="text-lg font-semibold">
        <span class="px-2 py-1 rounded text-sm <%= @bot.active? ? 'bg-green-100 text-green-800' : @bot.paused? ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
          <%= @bot.status %>
        </span>
      </div>
    </div>
  </div>

  <div class="bg-white p-4 rounded-lg shadow">
    <h2 class="text-lg font-semibold mb-4">AI Settings</h2>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <div class="text-sm text-gray-500">AI Enabled</div>
        <div class="font-medium"><%= @bot.ai_enabled ? "Yes 🤖" : "No" %></div>
      </div>
      <div>
        <div class="text-sm text-gray-500">ML Model</div>
        <div class="font-medium"><%= @bot.ml_model_id || "None" %></div>
      </div>
      <div>
        <div class="text-sm text-gray-500">High Threshold</div>
        <div class="font-medium"><%= @bot.ml_high_threshold || 0.8 %></div>
      </div>
      <div>
        <div class="text-sm text-gray-500">Low Threshold</div>
        <div class="font-medium"><%= @bot.ml_low_threshold || 0.3 %></div>
      </div>
    </div>
  </div>

  <div class="flex space-x-2">
    <%= link_to "Edit", edit_bot_path(@bot), class: "bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600" %>
    <%= link_to "Back", bots_path, class: "bg-gray-200 text-gray-800 px-4 py-2 rounded hover:bg-gray-300" %>
    <%= button_to "Delete", bot_path(@bot), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600" %>
  </div>
</div>
